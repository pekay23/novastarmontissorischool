    {
      "type": "rectangle",
      "id": "sync",
      "x": 600,
      "y": 500,
      "width": 550,
      "height": 200,
      "roundness": { "type": 3 },
      "backgroundColor": "#ffd8a8",
      "fillStyle": "solid",
      "strokeColor": "#1e1e1e",
      "strokeWidth": 2,
