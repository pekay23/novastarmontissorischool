    {
      "type": "text",
      "id": "database-label",
      "x": 70,
      "y": 520,
      "width": 460,
      "height": 160,
      "text": "DATABASE MODEL (Prisma + PostgreSQL)\n\nCore: School, AcademicYear, Term, Class, Subject\nPeople: User, Staff, Student, Parent, House\nAcademics: ClassSubject, ClassTerm, StudentClassTerm\nAssessment: Assessment, AssessmentScore (SBA, exams)\nAttendance: Attendance (daily + period)\nBehaviour: BehaviourRecord (positive/negative)\nFinance: FeeStructure, FeeItem, FeeInvoice, Payment, Ledger\nTimetable: Timetable, TimetableEntry\nCommunication: Message, Notification, Task\nReports: Report (templates, scheduled, exports)\nDocuments: StudentDocument (certificates, medical)\nAudit: AuditLog (immutable)\nSync: SyncLog (queue, status, conflicts)",
      "fontSize": 14,
      "fontFamily": 1,
      "strokeColor": "#1e1e1e",
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": "database",
      "originalText": "DATABASE MODEL (Prisma + PostgreSQL)\n\nCore: School, AcademicYear, Term, Class, Subject\nPeople: User, Staff, Student, Parent, House\nAcademics: ClassSubject, ClassTerm, StudentClassTerm\nAssessment: Assessment, AssessmentScore (SBA, exams)\nAttendance: Attendance (daily + period)\nBehaviour: BehaviourRecord (positive/negative)\nFinance: FeeStructure, FeeItem, FeeInvoice, Payment, Ledger\nTimetable: Timetable, TimetableEntry\nCommunication: Message, Notification, Task\nReports: Report (templates, scheduled, exports)\nDocuments: StudentDocument (certificates, medical)\nAudit: AuditLog (immutable)\nSync: SyncLog (queue, status, conflicts)",
      "autoResize": true
