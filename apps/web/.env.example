# Novastar Montessori School — Public Website Configuration

# Database (Neon)
DATABASE_URL=postgresql://user:pass@ep-xxx.neon.te/novastar?sslmode=require

# Supabase Backup
SUPABASE_DATABASE_URL=postgresql://user:pass@db.xxx.supabase.co/novastar?sslmode=require

# Environment
NODE_ENV=development

# MTN MoMo
MTN_MERCHANT_ID=
MTN_MERCHANT_KEY=

# Resend Email
RESEND_API_KEY=

# School Info
NEXT_PUBLIC_SCHOOL_NAME=Novastar Montessori School
NEXT_PUBLIC_SCHOOL_PHONE=+233244935251
NEXT_PUBLIC_SCHOOL_EMAIL=info@novastarmontissorischool.com
# Security (client-side deterrents only, not a security boundary)
NEXT_PUBLIC_SECURITY_SHIELD=0
NEXT_PUBLIC_SECURITY_DEVTOOLS_TRAP=0

# Private alternate marketing website (/school-preview/). Use a strong password.
MARKETING_PREVIEW_PASSWORD=
