# Novastar Montessori School — Platform Console (apps/super-admin)
#
# Names only. Every value here is blank on purpose: this file is committed, and a
# placeholder credential in a committed file is a credential that survives in a
# developer's shell history.
#
# The console is deny-by-default. There are no operator accounts in the
# environment at all — each operator is a `PlatformOperator` row created by
# `novastar-tenant operator` — so the only variable below that can be
# misconfigured into an open console is the signing secret, and a missing or short
# one means no session can be minted or verified. There is no development bypass
# and no default operator.

# --- Operator authentication (required) --------------------------------------
#
# PLATFORM_SESSION_SECRET signs the console's session cookie. The signing key is
# HKDF-derived from it, so the value itself is never used as an HMAC key. At least
# 32 characters; a shorter value is refused rather than padded.
#
# It is deliberately NOT an operator's password. Rotating it invalidates every
# issued session at once — that is the recovery lever when a signing key is
# suspected, and the reason it has its own variable. Rotating one operator's
# password touches only that operator.
#
# Do not reuse NEXTAUTH_SECRET: a shared secret means a portal session cookie and a
# console session cookie are signed by the same key, so a bug in either app's
# parsing would be a bug in both.
PLATFORM_SESSION_SECRET=

# --- Database ------------------------------------------------------------------
#
# Operator accounts live in the database, so this console cannot sign anybody in
# without a reachable database. It also cannot sign anybody in if the table is
# empty — which is the state a fresh deployment is in until the CLI has been run.
#
# SUPER_ADMIN_DATABASE_URL overrides DATABASE_URL for this app only. It exists so a
# deployment can point the console at a connection whose PostgreSQL role has broader
# grants than the portal's.
#
# IMPORTANT: it overrides the *connection string*, not the *role*. Creating a
# distinct PostgreSQL role with explicit grants is a migration and has not been
# written. Until it is, leaving this unset means the console connects with the same
# role as the portal. See the README's "Known gaps".
SUPER_ADMIN_DATABASE_URL=

# Fallback for deployments that do not set the override above.
DATABASE_URL=

# Read replica the health page reports on by name. Not connected to by this app:
# reporting freshness would need a second connection this console does not hold.
SUPABASE_DATABASE_URL=

# --- Tenant provisioning -------------------------------------------------------
#
# Initial administrator password for `POST /api/tenants` when the request omits
# `admin.password`. Never defaulted and never generated. Must be at least 12
# characters; the shared provisioning function enforces that.
TENANT_ADMIN_PASSWORD=

# --- Creating an operator (CLI-time only) ------------------------------------
#
# PLATFORM_OPERATOR_PASSWORD is read by `bun run operator`, never by this app:
# there is no route here that can create an operator, and that is deliberate —
# anything able to write the operator table is already inside the thing the table
# protects. The CLI prompts for the password when this is unset, so it may stay
# unset in a deployment's environment file entirely.
PLATFORM_OPERATOR_PASSWORD=

# --- Creating a school-level account -----------------------------------------
#
# Only needed by `POST /api/tenants/:id/users`, which creates an account and mails
# it a one-time setup link. Without RESEND_API_KEY the account is still created and
# the response is 502 with `setupEmailReason: "not-configured"` rather than a
# success, because "invited" with no email is the state that strands the recipient
# with an account they cannot sign into.
RESEND_API_KEY=

# NEXTAUTH_URL is the PORTAL's auth URL, not this console's, and it is
# read here for one reason: the setup link points at the portal's
# set-password page, which lives in apps/portal. A link built from this
# console's own origin would 404 in the recipient's browser, and for a
# 24-hour single-use token that is a support call. Set it to the portal's
# full auth URL — origin plus /portal/api/auth, e.g.
# https://<domain>/portal/api/auth — because that is also what the portal's
# own withAuth middleware needs; the link builder here reads only the
# origin of it and appends /portal itself. NEXT_PUBLIC_ORIGIN is the
# fallback for a setup that has only the public one.
NEXTAUTH_URL=
NEXT_PUBLIC_ORIGIN=

# --- URLs ----------------------------------------------------------------------
#
# Canonical URL of this console. On the single nms domain it is mounted at
# /admin (see root `vercel.json`), so this is the same origin as the portal and
# the public site — and the console's own cookie (`super_admin_session`) is
# still scoped to its own path, so it never collides with a portal session.
# Kept as a variable rather than hardcoded because the hostname is a deployment
# fact, not a code fact.
NEXT_PUBLIC_SUPER_ADMIN_URL=