# Novastar Montessori School — Portal Configuration

# Database (Neon - primary)
DATABASE_URL=postgresql://user:pass@ep-xxx.neon.tech/novastar?sslmode=require

# Supabase (backup / read-replica)
SUPABASE_DATABASE_URL=postgresql://user:pass@db.xxx.supabase.co/novastar?sslmode=require
SUPABASE_URL=https://xxx.supabase.co
SUPABASE_ANON_KEY=

# NextAuth
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=

# MTN MoMo
MTN_SUBSCRIPTION_KEY=
MTN_API_USER=
MTN_API_KEY=

# Email (Resend)
# REQUIRED for email-backed authentication. With this unset the portal cannot
# send anything, so no address can be verified, no invited person can set a
# password, and no one can reset a password. A failed send now throws rather
# than being logged and dropped, so a missing key is visible instead of silently
# stranding whoever is waiting on a link.
RESEND_API_KEY=

# Canonical public origin, used to build the verification, invitation and reset
# URLs that go out by email. A link built from the wrong origin 404s in the
# recipient's browser, which for a one-hour reset token is a support call.
# lib/auth/school-lookup.ts prefers NEXTAUTH_URL and falls back to this.
NEXT_PUBLIC_ORIGIN=http://localhost:3000

# Single sign-on with Google. Optional: with these unset no Google provider is
# registered at all, the sign-in page shows no Google button, and the credentials
# form is unaffected. Both halves are required — a client id without a secret is
# treated as no configuration, because NextAuth would accept it and fail at the
# moment somebody clicked. Copy them from Google Cloud Console → APIs & Services
# → Credentials. Never commit a real value.
# How to create them: docs/technical/2026-10-03_193000-sso-oauth-provider-setup.md
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Single sign-on with Microsoft Entra ID, including personal Outlook and
# Hotmail accounts. Same rule as Google: both halves or nothing. Copy them from
# the Entra admin centre → App registrations → your app → Certificates &
# credentials. Never commit a real value.
# How to create them: docs/technical/2026-10-03_193000-sso-oauth-provider-setup.md
MICROSOFT_ENTRA_ID_CLIENT_ID=
MICROSOFT_ENTRA_ID_CLIENT_SECRET=
