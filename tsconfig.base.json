{
  "compilerOptions": {
    "target": "ES2017",
    "lib": ["dom", "dom.iterable", "esnext"],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "incremental": true,
    "module": "esnext",
    "esModuleInterop": true,
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "react-jsx",
    "plugins": [{ "name": "next" }],
    "paths": {
      "@/*": ["./*"],
      "@novastar/shared-types/*": ["packages/shared-types/*"],
      "@novastar/shared-ui/*": ["packages/shared-ui/*"],
      "@novastar/shared-utils/*": ["packages/shared-utils/*"],
      "@novastar/sync-engine/*": ["packages/sync-engine/*"],
      "@novastar/auth/*": ["packages/auth/*"],
      "@novastar/database/*": ["packages/database/*"],
      "@novastar/ghana-education/*": ["packages/ghana-education/*"],
      "@novastar/notifications/*": ["packages/notifications/*"],
      "@novastar/payments/*": ["packages/payments/*"]
     }
  },
  "include": ["next-env.d.ts", "**/*.ts", "**/*.tsx", ".next/types/**/*.ts"],
  "exclude": ["node_modules", ".next", "scratch", "scripts", "**/*.test.ts", "**/*.test.tsx", "**/*.spec.ts", "**/*.spec.tsx"]
}