# Environment configuration for Novastar Montessori School
# Copy this file to .env and fill in actual values for your deployment

# ====================================================================
# Authentication & JWT
# ====================================================================
NEXTAUTH_SECRET=your-nextauth-secret-key-here-change-this-in-production
NEXTAUTH_URL=http://localhost:3000

# ====================================================================
# Database Connection
# ====================================================================
# Neon is the primary; Supabase is the failsafe the mirror copies into.
# Every key below must appear at most once across .env and .env.local.
# Duplicate keys are not an error in dotenv, they just resolve to the last
# one, which previously pointed the tooling at an unreachable host.
#
# DATABASE_URL      Neon, application traffic
# DATABASE_URL_POOLED Neon, pooled variant used by the app runtime
# DIRECT_URL        Neon, direct connection for migrations and DDL
# DATABASE_URL_RLS  Neon as the unprivileged RLS role, for verification only
#
# SUPABASE_DATABASE_URL        Supabase transaction pooler (:6543) — use this
# SUPABASE_DIRECT_URL          Supabase session pooler (:5432), for DDL
# SUPABASE_DATABASE_URL_RLS    Supabase as the unprivileged RLS role
DATABASE_URL=postgresql://username:password@localhost:5432/novastar_db
SUPABASE_DATABASE_URL=postgresql://username:password@localhost:5432/novastar_db

# ====================================================================
# External APIs
# ====================================================================

# MTN MoMo API (Ghana Mobile Money)
MTN_MERCHANT_ID=your-mtn-merchant-id-here

# Resend API for emails
RESEND_API_KEY=your-resend-api-key-here

# ====================================================================
# School Configuration
# ====================================================================
# School code used for authentication and tenant identification
DEFAULT_SCHOOL_CODE=NOVASTAR001

# Tenant ID for multi-tenancy
TENANT_ID=your-tenant-id-here

# School ID
SCHOOL_ID=your-school-id-here

# ====================================================================
# Payment System
# ====================================================================
# Bank transfer details
SCHOOL_BANK_NAME="Novastar Montessori School Account"
SCHOOL_BANK_ACCOUNT="1234567890"

# ====================================================================
# Configuration Entity Overrides
# ====================================================================
# Any configuration settings that should persist across deployments

# ====================================================================
# Security
# ====================================================================
# AWS credentials (if used)
AWS_ACCESS_KEY_ID=your-aws-access-key
AWS_SECRET_ACCESS_KEY=your-aws-secret-key

# ====================================================================
# Development Only
# ====================================================================
# Override for local development
# LOG_LEVEL=debug
# NEXT_PUBLIC_VERCEL_ENV=development

# ====================================================================
# Seed Configuration
# ====================================================================
# REQUIRED for first-time seeding. Set to a strong password.
# Omitting causes a console.warn and falls back to a default that
# must be changed after first login. The warning fires when the env
# var is UNSET (empty string or absent), so leave these commented
# or use a distinctly non-password placeholder.
# SEED_HEADMASTER_PASSWORD=<set-a-strong-password>
# SEED_PORTAL_ADMIN_PASSWORD=<set-a-strong-password>