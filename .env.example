# =============================================================================
# Local development environment
#
# Copy to .env.local and fill in real values:
#   cp .env.example .env.local      (POSIX)
#   Copy-Item .env.example .env.local   (PowerShell)
#
# This list is derived from what the code actually reads, not from what is
# "usually" configured. Every entry below appears in a `process.env` lookup in
# apps/, packages/ or tools/. If you add a variable, add it here too.
#
# apps/web/next.config.ts loads the repo-root .env and .env.local into
# process.env before Next boots, so `next dev` and `next build` pick these up
# without a per-app env file. Inside a container this does NOT apply — the
# server never evaluates next.config.ts — so docker-compose.yml passes the same
# values through `env_file`.
#
# .env and .env.local are gitignored. This file is the ONLY one that is tracked,
# and its values are placeholders — a pre-commit secret scanner
# (tools/scan-secrets.mjs, also run in CI) refuses a live-looking secret.
# Rotation steps for every real credential live in
# docs/technical/2026-10-12_secret-rotation-runbook.md.
# =============================================================================

# -----------------------------------------------------------------------------
# Database
# -----------------------------------------------------------------------------
# The Prisma client is built with `new PrismaNeon({ connectionString })`
# (@prisma/adapter-neon), which speaks Neon's SQL-over-HTTP protocol, NOT the
# PostgreSQL wire protocol. A local `postgres:16` container on tcp/5432 will not
# work with this URL. Point it at a real Neon database.
#
# Neon dashboard -> Connection Details. Use the -pooler host for the app and the
# direct host for migrations.
DATABASE_URL="postgresql://USER:PASSWORD@ep-XXXX-pooler.REGION.aws.neon.tech/neondb?sslmode=require"
DIRECT_URL="postgresql://USER:PASSWORD@ep-XXXX.REGION.aws.neon.tech/neondb?sslmode=require"

# The Supabase failsafe (mirror target). TWO variables for the same database,
# read by different tools, and the port is what makes them behave differently:
#
#   SUPABASE_DATABASE_URL  read by mirror.ts and tools/migrate's require-backup
#                          guard. Used VERBATIM, no port rewriting.
#   SUPABASE_DIRECT_URL    read by apply-schema.ts, which rewrites :6543/ ->
#                          :5432/ before connecting, so either value works.
#
# Both should carry port 5432, the SESSION pooler. Port 6543 is the transaction
# pooler: it takes no multi-statement transaction (so the mirror's whole-copy
# transaction cannot run on it) and by default it is IPv6-only, while 5432 is
# IPv4-proxied. The project ref must be part of the username: postgres.<ref>,
# not postgres.
#
# In CI these are secrets (see .github/workflows/db-mirror.yml). Locally put
# them in .env.local, which is gitignored.
# SUPABASE_DATABASE_URL="postgresql://postgres.projectref:PASSWORD@aws-1-eu-west-1.pooler.supabase.com:5432/postgres"
# SUPABASE_DIRECT_URL="postgresql://postgres.projectref:PASSWORD@aws-1-eu-west-1.pooler.supabase.com:5432/postgres"

# Optional: RLS-enforced connection, used by the tenant-isolation audit tooling.
# DATABASE_URL_RLS="postgresql://USER:PASSWORD@HOST/neondb?sslmode=require&options=-c%20row_security%3Don"

# Optional: separate database for the merged admin console (/admin/*). Without
# it the console uses DATABASE_URL — and NOTE it is never written back into
# DATABASE_URL at import time, which is how the old behaviour leaked a second
# connection into every request (see docs/audit-reports addendum).
# SUPER_ADMIN_DATABASE_URL="postgresql://USER:PASSWORD@HOST/neondb?sslmode=require"

# =============================================================================
# REQUIRED BY THE APP (apps/web serves public + portal + admin)
# =============================================================================
# Signs every session cookie, portal and admin-console alike. next.config.ts
# treats these as required and warns when they are missing.
# Generate the secret with: openssl rand -base64 32
NEXTAUTH_SECRET=""
# The app mounts its auth API at /portal/api/auth (the portal route group), so
# the value must carry that path. next-auth's withAuth proxy derives its
# session-exempt path from parseUrl(NEXTAUTH_URL).path and compares it against
# the full request path; a bare origin makes that path default to "/api/auth",
# which never matches "/portal/api/auth/*" — every unauthenticated call is then
# redirected and login deadlocks.
#
# The emailed-link builders read only the ORIGIN of this value and append the
# /portal mount path themselves, so the path here serves the proxy, not the
# links.
NEXTAUTH_URL="http://localhost:3000/portal/api/auth"

# Signs the admin console's platform-operator session cookie (a separate cookie
# from the portal's, because the two authenticate different populations).
# Without it no platform operator can sign in; the only symptom is a generic
# configuration alert on the login page. Minimum 32 characters; 48 random bytes
# is what a real deployment wants.
#
# Generate with: bun -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
#
# Never set this equal to NEXTAUTH_SECRET, never derive it from one, and never
# reuse an operator's password. Rotating it invalidates every console session
# at once, which makes rotation the recovery lever if the key is suspected.
#
# It must be listed in turbo.json's globalEnv or turbo strips it from every task
# environment, and a stripped variable is indistinguishable from an unset one.
PLATFORM_SESSION_SECRET=""

# =============================================================================
# Field-level encryption
# =============================================================================
# Master key for @/lib/security/encryption. Dedicated from NEXTAUTH_SECRET so
# rotating a session key does not silently rotate the data key (and so a leaked
# session key does not hand over every encrypted column). When UNSET, the module
# falls back to deriving from NEXTAUTH_SECRET and still decrypts; both paths are
# prefixed on the ciphertext so which key did what stays provable.
# Generate with: openssl rand -base64 32
ENCRYPTION_KEY=""

# =============================================================================
# PUBLIC (inlined into the client bundle at BUILD time)
# =============================================================================
# These are baked into the browser bundle by `next build`. Changing them later
# requires a rebuild — setting them on the running container does nothing.
NEXT_PUBLIC_ORIGIN="http://localhost:3000"
NEXT_PUBLIC_DOMAIN="localhost:3000"

# =============================================================================
# Infrastructure
# =============================================================================
# Rate limiting (apps/web/lib/rate-limit.ts) talks to Upstash over REST and
# falls back to an in-process Map when these are unset. It never speaks plain
# tcp://redis, so there is no local Redis container to run. In any multi-instance
# deployment the fallback is per-instance — set these when running more than one.
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""

# Number of proxy hops to trust when reading x-forwarded-for. Leave UNSET for
# local development (nothing to trust); the proxy then reports 'unknown' rather
# than honouring a header. Set it behind nginx / Vercel / a load balancer so
# rate limiting keys on the real client IP rather than the proxy's.
TRUSTED_PROXY_HOPS=""

# =============================================================================
# Supabase
# =============================================================================
# Only used for JWKS / auth lookups. Not needed if everything goes through
# NextAuth.
SUPABASE_URL=""
SUPABASE_SERVICE_ROLE_KEY=""

# =============================================================================
# Notifications (Resend)
# =============================================================================
# REQUIRED for email-backed authentication. Without it, packages/notifications
# throws EmailDeliveryError('not-configured') and every one of these is
# undeliverable, which means no address can be verified, no invited person can
# set a password, and no one can reset a password:
#   /verify-email   email confirmation
#   /set-password   one-time invitation setup link
#   /forgot-password /reset-password  password recovery
# Create a key at https://resend.com/api-keys and verify the sending domain.
RESEND_API_KEY=""

# Sender address for all outbound email. Resolution order:
#   1. Per-send override (options.from)
#   2. This variable (MAIL_FROM)
#   3. Fallback constant (uses novastarmontessori.com — a domain this project
#      does NOT own; any provider will refuse it until verified)
#
# Two deployment shapes:
#   - Verified domain: add DNS records from Resend, then set to an address on
#     that domain, e.g. "Novastar Montessori <noreply@your-domain.example>"
#   - Resend sandbox (testing ONLY): delivers only to the account's own email.
#     Use "onboarding@resend.dev". Every other recipient is rejected.
# Must be a full RFC 5322 address including display name.
MAIL_FROM=""

# =============================================================================
# Payments (MTN Mobile Money, Ghana) — verification credentials
# =============================================================================
# A mobile-money payment recorded without the collection call's provider
# reference can never be verified COMPLETED. With these credentials ABSENT,
# verification FAILS CLOSED to PENDING, which is the safe default: nothing
# settles, and the reconcile path below is how a bank transfer settles.
# Get them from the MTN MoMo developer portal for the collection product.
MTN_API_BASE_URL=""
MTN_API_USER=""
MTN_API_KEY=""
MTN_SUBSCRIPTION_KEY=""
MTN_TARGET_ENVIRONMENT=""

# Merchant details printed in the payer instructions.
MTN_MERCHANT_ID=""
SCHOOL_BANK_NAME=""
SCHOOL_BANK_ACCOUNT=""

# =============================================================================
# File storage (S3 or S3-compatible, e.g. MinIO / R2 / Neon)
# =============================================================================
# S3_BUCKET is required. The credential keys fall back to the standard AWS_*
# names when the S3_-prefixed ones are absent, so a deployment that already
# exports AWS credentials does not need a second copy of them.
S3_BUCKET=""
S3_REGION=""
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""
# Set for MinIO, R2 or Neon's S3-compatible endpoint. Omit it to use real AWS S3.
# S3_ENDPOINT="https://<endpoint>"
# Path-style addressing, which MinIO requires and every S3-compatible service
# accepts. Only set this to "false" if your provider requires virtual-host style.
S3_FORCE_PATH_STYLE="true"

# =============================================================================
# Multi-tenancy
# =============================================================================
# School code used to resolve which tenant a login belongs to. The project is a
# single school; the field exists so the code keeps working if another is added.
DEFAULT_SCHOOL_CODE=""

# =============================================================================
# Account provisioning (the tenant CLI) — the environment the seed reads
#
# The seed creates no accounts and reads no password. The two privileged
# accounts are created once, by a person who types the password at a masked
# prompt:
#
#   bun run tenant -- user --email headmaster@nms.com --tenant-code novastar
#   bun run tenant -- operator --email sp@dev.com
#
# Each stores only the argon2id hash; each is resettable by its owner with
# `--rotate` on the same command, or from /forgot-password once email is
# configured. Setting either variable below merely pre-fills the prompt for a
# scripted run — the prompt is the path that involves nobody.
#
# PLATFORM_OPERATOR_PASSWORD doubles as the composition-rule reference: the
# stronger of this and TENANT_ADMIN_PASSWORD policy is what the CLI enforces.
# =============================================================================
PLATFORM_OPERATOR_PASSWORD=""

# =============================================================================
# Deployment-only
# =============================================================================
# CI / release pipeline. Safe to leave blank locally.
# TURBO_TOKEN=""            # enables Turborepo remote cache -> much faster builds
# TURBO_TEAM=""
# VERCEL_TOKEN=""
# VERCEL_ORG_ID=""
# VERCEL_PROJECT_ID_WEB=""          # the one Vercel project (apps/web)
# VERCEL_DEPLOY_ENABLED="true"      # ci:deploy requires this
# DOCKER_REGISTRY="ghcr.io"
# DOCKER_USERNAME=""
# DOCKER_PASSWORD=""
# DOCKER_TAG="latest"
