# Dependencies
node_modules/

# Build outputs
.next/
out/
dist/
*.tsbuildinfo
next-env.d.ts

# Generated declarations emitted *next to sources* by a tsc run without an
# `outDir`. Every workspace package either consumes `.ts` source directly
# (ADR-016) or builds into `dist/`, so these files are pure build residue:
# they go stale, they are untracked, and they break `turbo run lint` because
# typescript-eslint cannot parse files outside the tsconfig project. Real
# declaration output lives in `dist/` (ignored above); the Next.js ones are
# `next-env.d.ts` (also ignored above).
packages/**/*.d.ts

# Turbo
.turbo/

# Stray JVM/Kotlin compiler output. This is a Bun/TypeScript monorepo, so a
# `*.class` file or a `META-INF/` at the repository root can only be the residue
# of a `kotlinc`/`javac` run pointed at the wrong directory. `Q1.class`,
# `Q2.class` and `META-INF/main.kotlin_module` all appeared that way, and no
# source file in this repository references any of them.
#
# `/META-INF/` is anchored rather than bare so a legitimately tracked
# `META-INF` inside a Java resource directory elsewhere would not be swallowed.
/META-INF/
*.class

# Environment files — NEVER commit secrets
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
!.env.example
# Ad-hoc copies of the above (hand-made backups, `cp .env .env.bak`, etc.).
# These are not matched by the literal rules above and were briefly untracked
# but committable, which is how real credentials almost get pushed.
.env.bak-*
.env.*.bak
.env.*.bak-*
*.env.bak

# OS files
.DS_Store
Thumbs.db

# Editor
.vscode/
.idea/
*.swp
*.swo

# Bun
bun.lockb

# Prisma migrations are tracked in git
# prisma/migrations/  # intentionally NOT gitignored

# Logs
logs/
*.log

# Uploads
uploads/
public/uploads/
# Root-level uploaded photos. These land in `public/images/` at the
# repository root (e.g. `children/`, `logos/`) when content is staged
# for the site, but they are uploads, not source: they belong in object
# storage (see the S3_* variables in .env.example), never in git, where
# they would be permanent in history. That is especially true of the
# `children/` set — photographs of minors. The leading `/` anchors the
# rule to the repository root so the apps' own asset directories, such
# as `apps/public-site/public/images/placeholders/`, stay tracked.
/public/images/

# Cache
.cache/
.parcel-cache/
.eslintcache
*.tsbuildinfo

# Hermes
.hermes/
.hermes-tmp.*

# Screenshots and visual baseline artifacts
screenshots/
**/screenshots/

# NOTE: tools/audit-baseline/ was previously ignored wholesale, which meant the
# tool's own source code and its findings.json could never be committed. Only
# the tool's generated output is ignored now — see tools/audit-baseline/.gitignore

# Documentation — nothing under docs/ is committed.
#
# The whole tree is owner-local: plans, ADRs, audit reports, business rules,
# wireframes and the generated HTML mirror all stay out of version control.
# `bun run docs:html` regenerates docs/html/ from the markdown sources, so the
# tree can always be rebuilt from the working copy. This replaces the earlier
# narrower rules that ignored only docs/html/, docs/adr/ADR-*.md and
# docs/technical/2026-10-01_*.md, which left 21 documentation files tracked.
docs/

# Local dev artifacts
*.db
*.db-journal
.css-check.css
null

# Playwright / E2E output.
# Reports and traces capture rendered page content and can contain session
# material, so these must never be committed by accident after a local run.
playwright-report/
test-results/

# Docker BuildKit layer cache written by `bun run ci:docker` and by
# docker-compose. Machine-local and large; .dockerignore excludes it from the
# build context too, and it must be excluded here as well.
.docker-cache/

# Vercel CLI local state. `vercel pull` writes .vercel/project.json and
# .vercel/.env.*.local containing the project's real environment variables, so
# this directory is as sensitive as .env itself.
.vercel/

# Agent Manager worktrees. Each `.kilo/worktrees/<name>/` is a full duplicate
# checkout of this repository, so an unignored entry here turns a routine
# `git add -A` into thousands of duplicate files. Committed rather than left in
# `.git/info/exclude` so the protection applies to every clone, not just this
# machine. Committable `.kilo/` config (kilo.jsonc, command/, agent/) stays
# tracked; only the runtime worktree state is excluded.
.kilo/worktrees/

.vercel
