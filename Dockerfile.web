# syntax=docker/dockerfile:1.7

# ============================================================================
# Novastar Montessori - merged web image (ADR-024)
#
# One image, one app: the public site (/), the portal (/portal/*) and the admin
# console (/admin/*) are all served by `apps/web` as a single SSR deployment.
#
# Why NOT `output: 'standalone'`: `apps/web/next.config.ts` deliberately leaves
# the output mode unset - the workspace packages are consumed as TypeScript
# source (ADR-016), so `next build` follows symlinks out of `apps/web` into
# `packages/*` and a standalone bundle would still need the whole source tree to
# run. That decision belongs to the app, so this Dockerfile adopts its shape
# rather than fighting it: the builder's workdir (source + node_modules + the
# built `.next`) is copied whole, and the app runs under `next start`.
#
# The cost is image size - roughly double a standalone image. The benefit is
# that the image cannot drift from how the app actually builds and runs.
# ============================================================================

ARG NODE_VERSION=22
ARG BUN_VERSION=1.4.0

# ----------------------------------------------------------------------------
FROM node:${NODE_VERSION}-alpine AS base

ENV NEXT_TELEMETRY_DISABLED=1 \
    NPM_CONFIG_UPDATE_NOTIFIER=false \
    CI=true

WORKDIR /app

# ----------------------------------------------------------------------------
# deps: install toolchain + workspace dependencies from manifests only
# ----------------------------------------------------------------------------
FROM base AS deps

ARG BUN_VERSION

RUN apk add --no-cache libc6-compat python3 make g++ \
    && npm install --global bun@${BUN_VERSION}

COPY package.json bun.lock turbo.json tsconfig.base.json biome.json ./

# --- workspace manifests (keep in sync with package.json "workspaces") ---
COPY apps/web/package.json          ./apps/web/
COPY packages/auth/package.json       ./packages/auth/
COPY packages/database/package.json   ./packages/database/
COPY packages/domain/package.json     ./packages/domain/
COPY packages/ghana-education/package.json ./packages/ghana-education/
COPY packages/notifications/package.json ./packages/notifications/
COPY packages/payments/package.json   ./packages/payments/
COPY packages/shared-types/package.json ./packages/shared-types/
COPY packages/shared-ui/package.json  ./packages/shared-ui/
COPY packages/shared-utils/package.json ./packages/shared-utils/
COPY packages/sync-engine/package.json ./packages/sync-engine/
COPY packages/testing/package.json    ./packages/testing/
COPY tools/db-mirror/package.json     ./tools/db-mirror/
COPY tools/migrate/package.json       ./tools/migrate/
COPY tools/seed/package.json          ./tools/seed/
COPY tools/sync-cli/package.json      ./tools/sync-cli/
COPY tools/tenant-cli/package.json    ./tools/tenant-cli/
# --- end workspace manifests ---

RUN bun install --frozen-lockfile

# ----------------------------------------------------------------------------
# builder: source, prisma client, next build
# ----------------------------------------------------------------------------
FROM deps AS builder

ARG NEXT_PUBLIC_ORIGIN
ARG NEXT_PUBLIC_DOMAIN
ARG NEXTAUTH_SECRET
ARG NEXTAUTH_URL
ARG DATABASE_URL

# NEXT_PUBLIC_* are inlined at build time; NEXTAUTH_SECRET/URL and DATABASE_URL
# are read at build time by next-auth's config resolution. All of them are also
# supplied at RUN time by the deployer's environment - these values only keep
# the build from failing, and the placeholder is never a real secret.
ENV NEXT_PUBLIC_ORIGIN=$NEXT_PUBLIC_ORIGIN \
    NEXT_PUBLIC_DOMAIN=$NEXT_PUBLIC_DOMAIN \
    DATABASE_URL=$DATABASE_URL \
    NEXTAUTH_SECRET=$NEXTAUTH_SECRET \
    NEXTAUTH_URL=$NEXTAUTH_URL

COPY . .

RUN bun run --cwd packages/database db:generate

# Build the merged web app (public + portal + admin)
RUN bun run build --filter=web

# ----------------------------------------------------------------------------
# runner: the built workdir, run under next start
# ----------------------------------------------------------------------------
FROM base AS runner

ENV NODE_ENV=production \
    PORT=3000 \
    HOSTNAME=0.0.0.0

RUN addgroup --gid 1001 --system nodejs \
    && adduser --uid 1001 --system nextjs

WORKDIR /app

# The whole builder workdir: source (the workspace packages are consumed as
# TypeScript source, so their sources are runtime dependencies), node_modules
# (bun symlinks the workspace packages into it), and the built `.next`.
COPY --from=builder --chown=nextjs:nodejs /app ./

USER nextjs

EXPOSE 3000

# Probe a page that exists in every deployment and redirects rather than 404s:
# `/login` 307-redirects to `/portal/login`, so `--redirect: manual` and a
# 2xx/3xx answer is healthy; anything else (including a 404) fails the check.
HEALTHCHECK --interval=30s --timeout=5s --start-period=20s --retries=3 \
  CMD node -e "fetch('http://127.0.0.1:'+(process.env.PORT||3000)+'/portal/login',{redirect:'manual'}).then(r=>process.exit(r.status>=200&&r.status<400?0:1)).catch(()=>process.exit(1))"

CMD ["bun", "run", "--cwd", "apps/web", "start"]
