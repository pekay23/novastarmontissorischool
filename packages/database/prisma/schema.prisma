generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["multiSchema"]
}

datasource db {
  provider = "postgresql"
  // URL moved to prisma.config.ts for Prisma 7+
  // Uses datasourceUrl: process.env.DATABASE_URL
}

// ============ TENANCY ============
model Tenant {
  id        String   @id @default(cuid())
  name      String
  code      String   @unique // subdomain: novastar, anotherschool
  domain    String? // custom domain
  isActive  Boolean  @default(true)
  settings  Json     @default("{}")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  schools               School[]
  users                 User[]
  academicYears         AcademicYear[]
  terms                 Term[]
  classLevels           ClassLevel[]
  subjects              Subject[]
  classes               Class[]
  gradingScales         GradingScale[]
  gradingLevels         GradingLevel[]
  assessmentTypeConfigs AssessmentTypeConfig[]
  feeCategories         FeeCategory[]
  paymentMethodConfigs  PaymentMethodConfig[]
  feeStructures         FeeStructure[]
  roles                 Role[]
  permissions           Permission[]
  delegations           Delegation[]
  attendanceTakers      AttendanceTaker[]
  staffs                Staff[]
  staffRoles            StaffRole[]
  departments           Department[]
  students              Student[]
  parents               Parent[]
  assessments           Assessment[]
  news                  News[]
  events                Event[]
  reportTemplates       ReportTemplate[]
  houses                House[]
  brandings             Branding[]
  configEntities        ConfigEntity[]
  syllabi               Syllabus[]
  systemConfigs         SystemConfig[]
  systemErrors          SystemError[]
}

model School {
  id          String   @id @default(cuid())
  tenantId    String
  tenant      Tenant   @relation(fields: [tenantId], references: [id])
  name        String
  code        String
  address     String
  phone       String
  email       String
  logoUrl     String?
  motto       String?
  established DateTime
  settings    Json     @default("{}")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  terms            Term[]
  classes          Class[]
  staff            Staff[]
  students         Student[]
  feeStructures    FeeStructure[]
  subjects         Subject[]
  classLevels      ClassLevel[]
  gradingScales    GradingScale[]
  assessmentTypes  AssessmentTypeConfig[]
  feeCategories    FeeCategory[]
  paymentMethods   PaymentMethodConfig[]
  roles            Role[]
  permissions      Permission[]
  delegations      Delegation[]
  houses           House[]
  news             News[]
  events           Event[]
  reportTemplates  ReportTemplate[]
  academicYears    AcademicYear[]
  attendanceTakers AttendanceTaker[]
  users            User[]
  staffRoles       StaffRole[]
  departments      Department[]
  parents          Parent[]
  assessments      Assessment[]
  brandings        Branding[]
  configEntities   ConfigEntity[]
  syllabi          Syllabus[]

  @@unique([tenantId, code])
}

// ============ CONFIGURABLE ACADEMIC STRUCTURE ============
model AcademicYear {
  id            String         @id @default(cuid())
  tenantId      String
  tenant        Tenant         @relation(fields: [tenantId], references: [id])
  schoolId      String
  school        School         @relation(fields: [schoolId], references: [id])
  name          String
  startDate     DateTime
  endDate       DateTime
  isCurrent     Boolean        @default(false)
  terms         Term[]
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  feeStructures FeeStructure[]

  @@unique([tenantId, schoolId, name])
}

model Term {
  id             String         @id @default(cuid())
  tenantId       String
  tenant         Tenant         @relation(fields: [tenantId], references: [id])
  schoolId       String
  school         School         @relation(fields: [schoolId], references: [id])
  academicYearId String
  academicYear   AcademicYear   @relation(fields: [academicYearId], references: [id])
  name           String
  startDate      DateTime
  endDate        DateTime
  isCurrent      Boolean        @default(false)
  status         TermStatus     @default(PLANNING)
  weeks          Int            @default(14)
  classes        ClassTerm[]
  assessments    Assessment[]
  feeInvoices    FeeInvoice[]
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
  feeStructures  FeeStructure[]
  enrollments    Enrollment[]
  timetables     Timetable[]
  syllabi        Syllabus[]

  @@unique([tenantId, schoolId, name, academicYearId])
}

enum TermStatus {
  PLANNING
  ACTIVE
  ASSESSMENT
  REPORTING
  CLOSED
}

model ClassLevel {
  id            String         @id @default(cuid())
  tenantId      String
  tenant        Tenant         @relation(fields: [tenantId], references: [id])
  schoolId      String
  school        School         @relation(fields: [schoolId], references: [id])
  code          String
  name          String
  phase         Phase
  order         Int
  ageMin        Int
  ageMax        Int
  subjects      SubjectLevel[]
  classes       Class[]
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  feeStructures FeeStructure[]

  @@unique([tenantId, schoolId, code])
}

enum Phase {
  KINDERGARTEN
  PRIMARY
  JHS
  SHS
}

model Subject {
  id            String          @id @default(cuid())
  tenantId      String
  tenant        Tenant          @relation(fields: [tenantId], references: [id])
  schoolId      String
  school        School          @relation(fields: [schoolId], references: [id])
  code          String
  name          String
  category      SubjectCategory
  isCore        Boolean         @default(true)
  creditHours   Int             @default(1)
  description   String?
  color         String?
  levels        SubjectLevel[]
  classSubjects ClassSubject[]
  assessments   Assessment[]
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt

  @@unique([tenantId, schoolId, code])
}

enum SubjectCategory {
  LANGUAGE
  MATHEMATICS
  SCIENCE
  SOCIAL_STUDIES
  CREATIVE_ARTS
  PHYSICAL_EDUCATION
  ICT
  RELIGIOUS_MORAL
  MONTESSORI_PRACTICAL
  MONTESSORI_SENSORIAL
  MONTESSORI_LANGUAGE
  MONTESSORI_MATHEMATICS
  MONTESSORI_CULTURAL
  OTHER
}

model SubjectLevel {
  id             String     @id @default(cuid())
  tenantId       String
  subjectId      String
  subject        Subject    @relation(fields: [subjectId], references: [id])
  classLevelId   String
  classLevel     ClassLevel @relation(fields: [classLevelId], references: [id])
  isRequired     Boolean    @default(true)
  periodsPerWeek Int        @default(4)

  @@unique([tenantId, subjectId, classLevelId])
}

model Class {
  id                 String              @id @default(cuid())
  tenantId           String
  tenant             Tenant              @relation(fields: [tenantId], references: [id])
  schoolId           String
  school             School              @relation(fields: [schoolId], references: [id])
  name               String
  levelId            String
  level              ClassLevel          @relation(fields: [levelId], references: [id])
  stream             String?
  capacity           Int                 @default(45)
  classTeacherId     String?
  classTeacher       Staff?              @relation("ClassTeacher", fields: [classTeacherId], references: [id])
  terms              ClassTerm[]
  students           Student[]
  subjects           ClassSubject[]
  timetables         Timetable[]
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
  attendanceTakers   AttendanceTaker[]
  enrollments        Enrollment[]
  attendanceStudents AttendanceStudent[]

  @@unique([tenantId, schoolId, name, levelId])
}

model ClassTerm {
  id       String  @id @default(cuid())
  tenantId String
  classId  String
  class    Class   @relation(fields: [classId], references: [id])
  termId   String
  term     Term    @relation(fields: [termId], references: [id])
  isActive Boolean @default(true)

  @@unique([tenantId, classId, termId])
}

model ClassSubject {
  id               String           @id @default(cuid())
  tenantId         String
  classId          String
  class            Class            @relation(fields: [classId], references: [id])
  subjectId        String
  subject          Subject          @relation(fields: [subjectId], references: [id])
  teacherId        String?
  teacher          Staff?           @relation("SubjectTeacher", fields: [teacherId], references: [id])
  periodsPerWeek   Int              @default(4)
  isActive         Boolean          @default(true)
  assessments      Assessment[]
  timetableEntries TimetableEntry[]
  syllabi          Syllabus[]

  @@unique([tenantId, classId, subjectId])
  // Teacher workspace and timetable both filter by teacher; without this the
  // query has no supporting index.
  @@index([tenantId, teacherId])
}

// ============ CONFIGURABLE GRADING ============
model GradingScale {
  id              String         @id @default(cuid())
  tenantId        String
  tenant          Tenant         @relation(fields: [tenantId], references: [id])
  schoolId        String?
  school          School?        @relation(fields: [schoolId], references: [id])
  name            String
  description     String?
  isDefault       Boolean        @default(false)
  appliesToLevels String[]
  levels          GradingLevel[]
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt
  scores          Score[]

  @@unique([tenantId, schoolId, name])
}

// A band of a grading scale. There is deliberately no grade-point column:
// percentage is the unit a primary or JHS terminal report is read on and
// `order` already sequences the bands. A 0-4 grade point existed only as an
// artefact of the removed 0-4 average.
model GradingLevel {
  id             String       @id @default(cuid())
  tenantId       String
  tenant         Tenant       @relation(fields: [tenantId], references: [id])
  gradingScaleId String
  gradingScale   GradingScale @relation(fields: [gradingScaleId], references: [id])
  key            String
  label          String
  minScore       Int
  maxScore       Int
  color          String
  description    String?
  order          Int

  // Band lookup is first-match (see `determineGrade` in shared-utils), so a
  // duplicate key or a duplicate order position makes the winning band a
  // function of row order rather than of the score. These two uniques are what
  // turn "silently arbitrary" into a rejected write.
  @@unique([gradingScaleId, key])
  @@unique([gradingScaleId, order])
}

// ============ CONFIGURABLE ASSESSMENT TYPES ============
model AssessmentTypeConfig {
  id              String       @id @default(cuid())
  tenantId        String
  tenant          Tenant       @relation(fields: [tenantId], references: [id])
  schoolId        String?
  school          School?      @relation(fields: [schoolId], references: [id])
  code            String
  name            String
  description     String?
  defaultWeight   Decimal      @default(1) @db.Decimal(3, 2)
  maxScore        Int          @default(100)
  appliesToLevels String[]
  isActive        Boolean      @default(true)
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt
  assessments     Assessment[]

  @@unique([tenantId, schoolId, code])
}

// ============ CONFIGURABLE FEES ============
model FeeCategory {
  id                  String               @id @default(cuid())
  tenantId            String
  tenant              Tenant               @relation(fields: [tenantId], references: [id])
  schoolId            String?
  school              School?              @relation(fields: [schoolId], references: [id])
  code                String
  name                String
  isRecurring         Boolean              @default(true)
  defaultMandatory    Boolean              @default(true)
  sortOrder           Int                  @default(0)
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt
  feeLineItems        FeeLineItem[]
  feeInvoiceLineItems FeeInvoiceLineItem[]

  @@unique([tenantId, schoolId, code])
}

model PaymentMethodConfig {
  id             String    @id @default(cuid())
  tenantId       String
  tenant         Tenant    @relation(fields: [tenantId], references: [id])
  schoolId       String?
  school         School?   @relation(fields: [schoolId], references: [id])
  code           String
  name           String
  instructions   String?
  isEnabled      Boolean   @default(true)
  sortOrder      Int       @default(0)
  providerConfig Json?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  payments       Payment[]

  @@unique([tenantId, schoolId, code])
}

model FeeStructure {
  id             String        @id @default(cuid())
  tenantId       String
  tenant         Tenant        @relation(fields: [tenantId], references: [id])
  schoolId       String
  school         School        @relation(fields: [schoolId], references: [id])
  name           String
  academicYearId String
  academicYear   AcademicYear  @relation(fields: [academicYearId], references: [id])
  termId         String?
  term           Term?         @relation(fields: [termId], references: [id])
  classLevelId   String
  classLevel     ClassLevel    @relation(fields: [classLevelId], references: [id])
  lineItems      FeeLineItem[]
  isActive       Boolean       @default(true)
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  @@unique([tenantId, schoolId, name, academicYearId, classLevelId])
}

model FeeLineItem {
  id             String       @id @default(cuid())
  tenantId       String
  feeStructureId String
  feeStructure   FeeStructure @relation(fields: [feeStructureId], references: [id])
  categoryId     String
  category       FeeCategory  @relation(fields: [categoryId], references: [id])
  amount         Decimal      @db.Decimal(12, 2)
  isMandatory    Boolean      @default(true)
  dueDate        DateTime?
  sortOrder      Int          @default(0)

  @@unique([tenantId, feeStructureId, categoryId])
}

// ============ DYNAMIC RBAC ============
model Role {
  id           String      @id @default(cuid())
  tenantId     String
  tenant       Tenant      @relation(fields: [tenantId], references: [id])
  schoolId     String?
  school       School?     @relation(fields: [schoolId], references: [id])
  name         String
  description  String?
  isSystem     Boolean     @default(false)
  permissions  String[]
  inheritsFrom String[]
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt
  users        User[]
  staffRoles   StaffRole[]

  @@unique([tenantId, schoolId, name])
}

model Permission {
  id          String   @id @default(cuid())
  tenantId    String
  tenant      Tenant   @relation(fields: [tenantId], references: [id])
  key         String
  description String
  category    String
  resource    String
  action      String
  scope       String
  isSystem    Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  school      School?  @relation(fields: [schoolId], references: [id])
  schoolId    String?

  @@unique([tenantId, key])
}

model Delegation {
  id               String    @id @default(cuid())
  tenantId         String
  tenant           Tenant    @relation(fields: [tenantId], references: [id])
  schoolId         String
  school           School    @relation(fields: [schoolId], references: [id])
  fromUserId       String
  fromUser         User      @relation("DelegationsFrom", fields: [fromUserId], references: [id])
  toUserId         String
  toUser           User      @relation("DelegationsTo", fields: [toUserId], references: [id])
  permissions      String[]
  requiresApproval Boolean   @default(true)
  context          String?
  expiresAt        DateTime?
  isActive         Boolean   @default(true)
  approvedById     String?
  approvedBy       User?     @relation("DelegationApprovals", fields: [approvedById], references: [id])
  approvedAt       DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
}

// ============ ATTENDANCE TAKERS (Configurable) ============
model AttendanceTaker {
  id             String   @id @default(cuid())
  tenantId       String
  tenant         Tenant   @relation(fields: [tenantId], references: [id])
  schoolId       String
  school         School   @relation(fields: [schoolId], references: [id])
  classId        String?
  class          Class?   @relation(fields: [classId], references: [id])
  staffId        String
  staff          Staff    @relation(fields: [staffId], references: [id])
  canMarkStudent Boolean  @default(true)
  canMarkStaff   Boolean  @default(false)
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@unique([tenantId, schoolId, classId, staffId])
}

// ============ USERS & STAFF ============
model User {
  id                   String    @id @default(cuid())
  tenantId             String
  tenant               Tenant    @relation(fields: [tenantId], references: [id])
  schoolId             String?
  school               School?   @relation(fields: [schoolId], references: [id])
  email                String
  emailVerified        DateTime?
  passwordHash         String?
  name                 String?
  image                String?
  roleId               String?
  role                 Role?     @relation(fields: [roleId], references: [id])
  isActive             Boolean   @default(true)
  lastLoginAt          DateTime?
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  // Security: account status (Aerojet Academy pattern, ADR-022)
  status               UserStatus   @default(ACTIVE)
  loginAttempts        Int?         @default(0)
  lockedUntil          DateTime?

  // Security: 2FA (TOTP)
  twoFactorEnabled     Boolean      @default(false)
  twoFactorSecret      String?      // encrypted at rest
  settings             Json?        // lastTotpCounter, etc.

  // Security: passkey bridge (Aerojet Academy pattern)
  passkeyBridgeToken   String?      @unique
  passkeyBridgeExpires DateTime?

  // Security: password change enforcement
  mustChangePassword   Boolean      @default(false)
  passwordChangedAt    DateTime?
  verifyToken          String?      @unique
  verifyTokenExpires   DateTime?

  accounts            Account[]
  sessions            Session[]
  staff               Staff?
  student             Student?
  delegationsFrom     Delegation[]        @relation("DelegationsFrom")
  delegationsTo       Delegation[]        @relation("DelegationsTo")
  delegationApprovals Delegation[]        @relation("DelegationApprovals")
  createdNews         News[]              @relation("NewsAuthor")
  // Internal staff notices, which are a different surface from the public
  // marketing CMS above. Separate relation because `Announcement` and `News`
  // are both "a thing this person wrote" and would otherwise be ambiguous.
  announcements       Announcement[]      @relation("AnnouncementAuthor")
  parent              Parent?
  assessments         Assessment[]
  scores              Score[]
  attendanceStudents  AttendanceStudent[]
  attendanceStaffs    AttendanceStaff[]

  // The four reason-gated locks (Student, Parent, AttendanceStudent,
  // AttendanceStaff). Each is named because all four models ALREADY have an
  // unrelated relation back to `User` — `Student.user`, `Parent.user`,
  // `AttendanceStudent.markedBy`, `AttendanceStaff.markedBy` — and Prisma
  // rejects two unnamed relations between the same pair of models.
  finalizedAttendanceStudents AttendanceStudent[] @relation("FinalizedAttendanceStudents")
  finalizedAttendanceStaffs   AttendanceStaff[]   @relation("FinalizedAttendanceStaffs")
  finalizedStudents           Student[]           @relation("FinalizedStudents")
  finalizedParents            Parent[]            @relation("FinalizedParents")
  payments            Payment[]
  messages            Message[]
  notifications       Notification[]
  leaveRequests       LeaveRequest[]
   auditLogs           AuditLog[]
    // Every value change this account made that had to carry a reason. The
    // trail outlives the account: an account that has made an amendment cannot be
    // deleted at all, because doing so would break the exactly-one-actor CHECK.
    recordAmendments        RecordAmendment[]
    passkeys            Passkey[]
    passkeyChallenges   PasskeyChallenge[]
     systemErrors        SystemError[]     @relation("ReportedErrors")
    resolvedErrors      SystemError[]     @relation("ResolvedErrors")

   @@unique([tenantId, email])
}

// Security: account status enum (Aerojet Academy pattern, ADR-022)
enum UserStatus {
  ACTIVE
  SUSPENDED
  ARCHIVED
  DELETED
}

// ============ PLATFORM OPERATORS (cross-tenant, tenantless) ============
//
// The identity behind `apps/super-admin`. A platform operator belongs to no
// tenant, so there is no correct `User` row to create: `User.tenantId` is
// non-null, and borrowing `HEADMASTER` would hand a cross-tenant account a
// school-level role — the exact outcome the separate console exists to prevent.
// This model is the deliberate alternative, and it is the reason the console is a
// separate app rather than a route group inside the portal.
//
// Deliberately a separate row type rather than a `User` with a nullable tenantId:
// nullability would make "belongs to no school" a value the database accepts
// anywhere, and every portal query that assumes a tenant would have to defend
// against it.
//
// `status` reuses `UserStatus` rather than declaring a second lifecycle enum, so
// "suspended" means one thing platform-wide and a cross-app query needs one filter.
// The lockout columns (`loginAttempts`, `lockedUntil`) are the same pair `User`
// carries, for the same reason: one sweep and one policy for every credential in
// the system, and no second set of thresholds to keep in step.
model PlatformOperator {
  id                 String     @id @default(cuid())
  username           String     @unique
  email              String     @unique
  name               String?
  passwordHash       String
  status             UserStatus @default(ACTIVE)
  capabilities       String[]
  mustChangePassword Boolean    @default(false)
  passwordChangedAt  DateTime?
  lastLoginAt        DateTime?
  loginAttempts      Int?       @default(0)
  lockedUntil        DateTime?
  createdAt          DateTime   @default(now())
  updatedAt          DateTime   @updatedAt
  auditLogs          AuditLog[]
  // Same SET NULL treatment as `auditLogs`, and with the same caveat: this row's
  // deletion is refused while it has amendments, because the exactly-one-actor
  // CHECK is evaluated on the UPDATE that SET NULL performs. See the model
  // comment's "FOREIGN KEYS" section.
  recordAmendments   RecordAmendment[]

  // Serves the lockout sweep — "every active operator whose lock has lapsed" —
  // which is otherwise a sequential scan of the whole operator table on every
  // administrative pass. Deliberately not a partial index: Prisma cannot express
  // one, and `status` first is what makes the sweep's own `status = 'ACTIVE'`
  // predicate the leading column of the scan.
  @@index([status, lockedUntil])
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expires      DateTime
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model Staff {
  id               String            @id @default(cuid())
  tenantId         String
  tenant           Tenant            @relation(fields: [tenantId], references: [id])
  schoolId         String
  school           School            @relation(fields: [schoolId], references: [id])
  userId           String            @unique
  user             User              @relation(fields: [userId], references: [id])
  employeeId       String
  firstName        String
  lastName         String
  otherNames       String?
  gender           Gender
  dateOfBirth      DateTime?
  phone            String
  email            String
  address          String?
  hireDate         DateTime
  status           StaffStatus       @default(ACTIVE)
  roleId           String?
  role             StaffRole?        @relation(fields: [roleId], references: [id])
  departmentId     String?
  department       Department?       @relation(fields: [departmentId], references: [id])
  managerId        String?
  manager          Staff?            @relation("StaffManager", fields: [managerId], references: [id])
  subordinates     Staff[]           @relation("StaffManager")
  classesTaught    Class[]           @relation("ClassTeacher")
  subjectsTaught   ClassSubject[]    @relation("SubjectTeacher")
  attendances      AttendanceStaff[]
  leaveRequests    LeaveRequest[]
  bookLoans        BookLoan[]
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  attendanceTakers AttendanceTaker[]
  houses           House[]

  @@unique([tenantId, schoolId, employeeId])
}

enum Gender {
  MALE
  FEMALE
  OTHER
}

enum StaffStatus {
  ACTIVE
  ON_LEAVE
  SUSPENDED
  TERMINATED
}

model StaffRole {
  id          String   @id @default(cuid())
  tenantId    String
  tenant      Tenant   @relation(fields: [tenantId], references: [id])
  schoolId    String
  school      School   @relation(fields: [schoolId], references: [id])
  name        String
  description String?
  baseRoleId  String?
  baseRole    Role?    @relation(fields: [baseRoleId], references: [id])
  permissions String[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  staffs      Staff[]

  @@unique([tenantId, schoolId, name])
}

model Department {
  id        String   @id @default(cuid())
  tenantId  String
  tenant    Tenant   @relation(fields: [tenantId], references: [id])
  schoolId  String
  school    School   @relation(fields: [schoolId], references: [id])
  name      String
  code      String
  headId    String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  staffs    Staff[]

  @@unique([tenantId, schoolId, code])
}

// ============ STUDENTS ============
model Student {
  id                 String              @id @default(cuid())
  tenantId           String
  tenant             Tenant              @relation(fields: [tenantId], references: [id])
  schoolId           String
  school             School              @relation(fields: [schoolId], references: [id])
  userId             String?             @unique
  user               User?               @relation(fields: [userId], references: [id])
  studentId          String
  firstName          String
  lastName           String
  otherNames         String?
  gender             Gender
  dateOfBirth        DateTime
  admissionDate      DateTime
  admissionNumber    String
  status             StudentStatus       @default(ACTIVE)
  classId            String?
  class              Class?              @relation(fields: [classId], references: [id])
  houseId            String?
  house              House?              @relation(fields: [houseId], references: [id])
  parentId           String?
  parent             Parent?             @relation(fields: [parentId], references: [id])
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt

  // Reason-gated lock — see the RecordAmendment model comment for the full
  // rationale. NULL means the profile is still open; a value means it was
  // settled on that date by that person, and any later edit has to carry a
  // written reason. Deliberately NOT an immutability flag: the row stays
  // editable and unlocking is clearing these two columns, because a school
  // would rather amend a child's record with a reason on it than be told the
  // system will not let them fix a typo.
  finalizedAt   DateTime?
  finalizedById String?
  finalizedBy   User?                @relation("FinalizedStudents", fields: [finalizedById], references: [id])

  enrollments        Enrollment[]
  scores             Score[]
  attendanceStudents AttendanceStudent[]
  feeInvoices        FeeInvoice[]
  payments           Payment[]
  bookLoans          BookLoan[]

  @@unique([tenantId, schoolId, studentId])
  @@unique([tenantId, schoolId, admissionNumber])
}

enum StudentStatus {
  ACTIVE
  GRADUATED
  TRANSFERRED
  WITHDRAWN
  SUSPENDED
}

