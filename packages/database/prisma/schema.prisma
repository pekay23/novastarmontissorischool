// ============ ASSESSMENT & SCORES ============
model Assessment {
  id             String               @id @default(cuid())
  tenantId       String
  tenant         Tenant               @relation(fields: [tenantId], references: [id])
  schoolId       String
  school         School               @relation(fields: [schoolId], references: [id])
  classSubjectId String
  classSubject   ClassSubject         @relation(fields: [classSubjectId], references: [id])
  termId         String
  term           Term                 @relation(fields: [termId], references: [id])
  typeId         String
  type           AssessmentTypeConfig @relation(fields: [typeId], references: [id])
  name           String
  description    String?
  maxScore       Int                  @default(100)
  // Nullable, and that is the point: NULL means "this assessment carries no
  // weight of its own" and the weight its AssessmentTypeConfig configures
  // applies. The column was `NOT NULL DEFAULT 1`, which made that indistinguishable
  // from a teacher explicitly choosing 1.00 for one assessment, so an explicit
  // 1.00 was discarded in favour of the type default. There is no sentinel now:
  // see `resolveAssessmentWeight` in @novastar/shared-utils, which is also why
  // nothing may divide by this value without resolving it first.
  weight         Decimal?             @db.Decimal(3, 2)
  assessmentDate DateTime
  dueDate        DateTime?
  isPublished    Boolean              @default(false)
  publishedAt    DateTime?
  createdById    String
  createdBy      User                 @relation(fields: [createdById], references: [id])
  scores         Score[]
  createdAt      DateTime             @default(now())
  updatedAt      DateTime             @updatedAt
  subject        Subject?             @relation(fields: [subjectId], references: [id])
  subjectId      String?
}

model Score {
  id             String        @id @default(cuid())
  tenantId       String
  assessmentId   String
  assessment     Assessment    @relation(fields: [assessmentId], references: [id])
  studentId      String
  student        Student       @relation(fields: [studentId], references: [id])
  rawScore       Decimal       @db.Decimal(6, 2)
  percentage     Decimal       @db.Decimal(5, 2)
  grade          String?
  gradingScaleId String?
  gradingScale   GradingScale? @relation(fields: [gradingScaleId], references: [id])
  isApproved     Boolean       @default(false)
  approvedById   String?
  approvedBy     User?         @relation(fields: [approvedById], references: [id])
  approvedAt     DateTime?
  notes          String?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  @@unique([tenantId, assessmentId, studentId])
}

// ============ ATTENDANCE ============
model AttendanceStudent {
  id         String           @id @default(cuid())
  tenantId   String
  studentId  String
  student    Student          @relation(fields: [studentId], references: [id])
  classId    String
  class      Class            @relation(fields: [classId], references: [id])
date       DateTime
  status     AttendanceStatus
  // NOT NULL with an empty-string default, not a nullable column: the unique
  // constraint below includes `period`, and PostgreSQL treats every NULL as
  // distinct, so a nullable `period` made the constraint unreachable and every
  // re-save of the same student/day inserted a duplicate row. `''` is the
  // whole-day sentinel, so it keeps the unique index meaningful.
  period     String        @default("")
  markedById String
  markedBy   User             @relation(fields: [markedById], references: [id])
  notes      String?
  createdAt  DateTime         @default(now())
  updatedAt  DateTime         @updatedAt

  @@unique([tenantId, studentId, date, period])
}

model AttendanceStaff {
  id         String           @id @default(cuid())
  tenantId   String
  staffId    String
  staff      Staff            @relation(fields: [staffId], references: [id])
  date       DateTime
  status     AttendanceStatus
  // See AttendanceStudent.period — the same nullable-period defect applied here.
  period     String           @default("")
  markedById String?
  markedBy   User?            @relation(fields: [markedById], references: [id])
  notes      String?
  createdAt  DateTime         @default(now())
  updatedAt  DateTime         @updatedAt

  @@unique([tenantId, staffId, date, period])
}

enum AttendanceStatus {
  PRESENT
  ABSENT
  LATE
  EXCUSED
  HALF_DAY
}

