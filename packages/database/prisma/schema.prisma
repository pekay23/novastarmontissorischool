// ============ AUDIT ============
model AuditLog {
  id        String   @id @default(cuid())
  tenantId  String
  schoolId  String
  userId    String?
  user      User?    @relation(fields: [userId], references: [id])
  // The operator who acted, for entries written by the cross-tenant console.
  //
  // A sibling of `userId`, not a replacement: an operator has no `User` row, so
  // before this column every console action was written with `userId: null` and
  // the audit trail could say *that* something happened but never *who* did it.
  // Pointing `userId` at the nearest school administrator would be worse than
  // null — it would attribute a platform-wide action to a tenant member who did
  // not perform it. So the two identities are separate columns and a console
  // entry names exactly one of them.
  operatorId String?
  operator   PlatformOperator? @relation(fields: [operatorId], references: [id])
  action    String
  entity    String
   entityId  String?
   description String?
   oldData   Json?
  newData   Json?
  ipAddress String?
  userAgent String?
  createdAt DateTime @default(now())

  // Hash chain: each entry hashes the previous entry's hash for tamper evidence
  previousHash String?
  hash         String?

   @@index([tenantId, schoolId, createdAt])
   @@index([tenantId, entity, entityId])
  // "Everything this operator did" is the question the new column exists to
  // answer, so it gets its own index rather than relying on a scan.
   @@index([operatorId])
}

model Passkey {
  id           String    @id @default(cuid())
  userId       String
  user         User      @relation(fields: [userId], references: [id])
  credentialId String    @unique
  publicKey    String    // base64url-encoded DER public key
  counter      BigInt    @default(0)
  name         String?
  transports   String[]  // 'usb' | 'nfc' | 'ble' | 'internal'
  createdAt    DateTime  @default(now())
  lastUsedAt   DateTime?
}

model PasskeyChallenge {
  id        String   @id @default(cuid())
  userId    String?
  user      User?    @relation(fields: [userId], references: [id])
  challenge String   @unique // base64url-encoded challenge
  type      String   // 'registration' | 'authentication'
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([expiresAt])
}

// ============ SYSTEM CONFIG / FEATURE FLAGS ============
model SystemConfig {
  id          String   @id @default(cuid())
  tenantId    String
  tenant      Tenant   @relation(fields: [tenantId], references: [id])
  key         String
  value       Json
  description String?
  category    String?
  isEditable  Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @default(now()) @updatedAt
  // Optimistic-concurrency token for cross-tab writes. The default only ever
  // applies to the column's initial value, so `create` sets 1 explicitly and an
  // absent row reads as 0: a created row must be distinguishable from no row at
  // all, or a first write would look like it matched a precondition of 0 that
  // was never issued. Every later write increments, and deleting the row returns
  // the flag to 0 — which is how a reset invalidates another tab's precondition.
  version     Int      @default(0)

  @@unique([tenantId, key])
  @@index([tenantId, category])
}

// ============ SYSTEM ERROR LOGGING ============
model SystemError {
  id        String         @id @default(cuid())
  tenantId  String
  tenant    Tenant         @relation(fields: [tenantId], references: [id])
  errorType String
  message   String
  stack     String?
  endpoint  String?
  userId    String?
  user      User?          @relation("ReportedErrors", fields: [userId], references: [id])
  severity  ErrorSeverity  @default(MEDIUM)
  resolved  Boolean        @default(false)
  resolvedAt DateTime?
  resolvedBy String?
  resolvedByUser User?      @relation("ResolvedErrors", fields: [resolvedBy], references: [id])
  createdAt DateTime       @default(now())
  updatedAt DateTime       @default(now()) @updatedAt

  @@index([tenantId, severity, createdAt])
  @@index([tenantId, resolved, createdAt])
}

enum ErrorSeverity {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum LogLevel {
  DEBUG
  INFO
  WARN
  ERROR
  FATAL
}

model LogEntry {
  id        String   @id @default(cuid())
  level     LogLevel
  message   String
  context   Json?
  createdAt DateTime @default(now())

  @@index([level, createdAt])
}
