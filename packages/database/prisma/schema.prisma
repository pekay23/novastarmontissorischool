  student        Student       @relation(fields: [studentId], references: [id])
  rawScore       Decimal       @db.Decimal(6, 2)
  percentage     Decimal       @db.Decimal(5, 2)
  grade          String?
  gradingScaleId String?
  gradingScale   GradingScale? @relation(fields: [gradingScaleId], references: [id])
  isApproved     Boolean       @default(false)
  approvedById   String?
  approvedBy     User?         @relation(fields: [approvedById], references: [id])
  approvedAt     DateTime?
  notes          String?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  @@unique([tenantId, assessmentId, studentId])
}

// ============ ATTENDANCE ============
model AttendanceStudent {
  id         String           @id @default(cuid())
  tenantId   String
  studentId  String
  student    Student          @relation(fields: [studentId], references: [id])
  classId    String
  class      Class            @relation(fields: [classId], references: [id])
date       DateTime
  status     AttendanceStatus
  // NOT NULL with an empty-string default, not a nullable column: the unique
  // constraint below includes `period`, and PostgreSQL treats every NULL as
  // distinct, so a nullable `period` made the constraint unreachable and every
  // re-save of the same student/day inserted a duplicate row. `''` is the
  // whole-day sentinel, so it keeps the unique index meaningful.
  period     String        @default("")
  markedById String
  markedBy   User             @relation(fields: [markedById], references: [id])
  notes      String?
  createdAt  DateTime         @default(now())
  updatedAt  DateTime         @updatedAt

  // Reason-gated lock, as on Student. Attendance is the record most likely to be
  // disputed after the fact and the hardest to audit, because the row carries no
  // separate "last changed by" column at all: `PATCH /api/attendance/[id]`
  // overwrites `markedById` with the correcting user, so the original marker is
  // gone. See the RecordAmendment model comment for what that costs.
  finalizedAt   DateTime?
  finalizedById String?
  finalizedBy   User?           @relation("FinalizedAttendanceStudents", fields: [finalizedById], references: [id])

  @@unique([tenantId, studentId, date, period])
}

model AttendanceStaff {
  id         String           @id @default(cuid())
  tenantId   String
  staffId    String
  staff      Staff            @relation(fields: [staffId], references: [id])
  date       DateTime
  status     AttendanceStatus
  // See AttendanceStudent.period — the same nullable-period defect applied here.
  period     String           @default("")
  markedById String?
  markedBy   User?            @relation(fields: [markedById], references: [id])
  notes      String?
  createdAt  DateTime         @default(now())
  updatedAt  DateTime         @updatedAt

  // Reason-gated lock, as on AttendanceStudent — and the same `markedById`
  // overwrite applies here, which is why `markedById` is optional on this model.
  finalizedAt   DateTime?
  finalizedById String?
  finalizedBy   User?           @relation("FinalizedAttendanceStaffs", fields: [finalizedById], references: [id])

  @@unique([tenantId, staffId, date, period])
}

enum AttendanceStatus {
  PRESENT
  ABSENT
  LATE
  EXCUSED
  HALF_DAY
}

