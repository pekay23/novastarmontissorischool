// ============ ASSESSMENT & SCORES ============
model Assessment {
  id             String               @id @default(cuid())
  tenantId       String
  tenant         Tenant               @relation(fields: [tenantId], references: [id])
  schoolId       String
  school         School               @relation(fields: [schoolId], references: [id])
  classSubjectId String
  classSubject   ClassSubject         @relation(fields: [classSubjectId], references: [id])
  termId         String
  term           Term                 @relation(fields: [termId], references: [id])
  typeId         String
  type           AssessmentTypeConfig @relation(fields: [typeId], references: [id])
  name           String
  description    String?
  maxScore       Int                  @default(100)
  // Nullable, and that is the point: NULL means "this assessment carries no
  // weight of its own" and the weight its AssessmentTypeConfig configures
  // applies. The column was `NOT NULL DEFAULT 1`, which made that indistinguishable
  // from a teacher explicitly choosing 1.00 for one assessment, so an explicit
  // 1.00 was discarded in favour of the type default. There is no sentinel now:
  // see `resolveAssessmentWeight` in @novastar/shared-utils, which is also why
  // nothing may divide by this value without resolving it first.
  weight         Decimal?             @db.Decimal(3, 2)
  assessmentDate DateTime
  dueDate        DateTime?
  isPublished    Boolean              @default(false)
  publishedAt    DateTime?
  createdById    String
  createdBy      User                 @relation(fields: [createdById], references: [id])
  scores         Score[]
  createdAt      DateTime             @default(now())
  updatedAt      DateTime             @updatedAt
  subject        Subject?             @relation(fields: [subjectId], references: [id])
  subjectId      String?
}

model Score {
  id             String        @id @default(cuid())
  tenantId       String
  assessmentId   String
