// ============ INTERNAL COMMS (staff-only; never the public site) ============
//
// WHY THIS IS NOT `News`
// ----------------------
// `News` is the public marketing CMS: `apps/public-site/lib/data.ts` renders it,
// filtered on nothing but `status: 'PUBLISHED'`, and it is read at BUILD time by a
// static export. `POST /api/announcements` nonetheless writes its staff notices
// there, so an internal notice addressed to one classroom teacher is one
// `status` flip away from appearing on the school's public homepage. That is the
// defect this model exists to end.
//
// The two tables are therefore separate storage, not a shared one with a flag.
// `audience` on `News` already exists and is not a containment boundary: nothing
// reads it on the public path, so it selects nothing there.
//
// `tenantId`/`schoolId` are plain columns with no relation, matching `AuditLog` —
// the closest sibling, and also an internal record. Every read of this table is
// scoped by an explicit `where`, and `Announcement` has no back-relation on
// `Tenant` or `School` because it does not need one.
//
// `AnnouncementStatus` is declared as its own enum rather than reusing
// `ContentStatus`, which holds the same three values. That is a deliberate
// redundancy, not an oversight: this table's lifecycle is set by a school
// administrator and is not part of the public publishing workflow, so coupling
// the two would mean a change to how the marketing CMS is moderated could
// silently break internal notices. The cost is one more Postgres enum type.
model Announcement {
  id       String @id @default(cuid())
  tenantId String
  schoolId String
  title    String
  // The notice body. `bodyEn`/`bodyTw` are deliberately NOT reused: this is a
  // single internal notice written once by staff, not a bilingual published
  // article needing per-locale bodies.
  body     String            @db.Text
  // Role names to target, e.g. `['CLASSROOM_TEACHER']`. An empty array means
  // every role in the school, which is the common case for a general notice.
  // Deliberately a string array and not an enum: the portal's role vocabulary is
  // a `Role` table, not a closed set, and a notice must be able to name a role
  // that exists without a migration.
  audience String[]
  status   AnnouncementStatus @default(DRAFT)
  // Set when the notice goes live, NULL while it is a draft. Kept separate from
  // `updatedAt` so "when was this first shown to staff" is answerable after
  // later edits.
  publishedAt DateTime?
  authorId    String
  author      User      @relation("AnnouncementAuthor", fields: [authorId], references: [id])
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([tenantId, schoolId, status, publishedAt])
  @@index([authorId])
}

enum AnnouncementStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

