model FeeInvoice {
  id            String               @id @default(cuid())
  tenantId      String
  schoolId      String
  studentId     String
  student       Student              @relation(fields: [studentId], references: [id])
  termId        String
  term          Term                 @relation(fields: [termId], references: [id])
  invoiceNumber String
  totalAmount   Decimal              @db.Decimal(12, 2)
  paidAmount    Decimal              @default(0) @db.Decimal(12, 2)
  balance       Decimal              @db.Decimal(12, 2)
  status        InvoiceStatus        @default(PENDING)
  dueDate       DateTime
  issuedAt      DateTime             @default(now())
  paidAt        DateTime?
  lineItems     FeeInvoiceLineItem[]
  payments      Payment[]
  createdAt     DateTime             @default(now())
  updatedAt     DateTime             @updatedAt

  // Scoped to the school, not global. `generateInvoiceNumber`
  // (packages/domain/src/finance.ts) counts invoices for (tenantId, schoolId,
  // year) and renders `INV-<year>-<count+1>`, so two schools in one tenant both
  // start at `INV-2026-0001`. Under a global `@unique` the second school's first
  // invoice of the year failed on a constraint collision — the constraint
  // contradicted the generator that fed it. These three columns are exactly the
  // scope the generator counts on.
  @@unique([tenantId, schoolId, invoiceNumber])
}

