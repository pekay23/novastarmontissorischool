  lastName   String
  phone      String
  email      String
  address    String?
  occupation String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  // Reason-gated lock, as on Student. Contact details are the most frequently
  // corrected fields in the whole register — a guardian changes phone, moves,
  // changes email — which is exactly why the correction needs to leave a record
  // instead of overwriting the previous value in place.
  finalizedAt   DateTime?
  finalizedById String?
  finalizedBy   User?     @relation("FinalizedParents", fields: [finalizedById], references: [id])

