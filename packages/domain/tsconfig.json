{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "lib": ["esnext"],
    "noEmit": true,
    "noUncheckedIndexedAccess": true,
    "types": ["node", "bun"],
    "paths": {
      "@novastar/*": ["../../packages/*/index.ts"]
    }
  },
  "include": ["index.ts", "src/**/*.ts", "tests/**/*.ts", "tests/**/*.tsx"],
  "exclude": ["node_modules"]
}
